generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password   String
  isVerified Boolean  @default(false)
  otp        String?
  otpExpiry  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
